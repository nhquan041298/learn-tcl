proc findmax { items } {
  set max 0
  foreach i $items { 
    if { $i > $max } {
      set max $i
    }
  }
 return $max
}

proc findmin { items } {
  set min "NO VIO"
  foreach i $items { 
    if { $i < $min } {
      set min [format %f $i]
    }
  }
 return $min
}

proc cal_sum { items } {
set sum 0
foreach i $items {
 set sum [expr $sum + $i]
}
return $sum
}


proc get_info_for_adjust_clock {PIN type value_l value_c} {
set i 0
set end_TG [filter_collection [all_fanout -from $PIN -flat] "is_clock_source_network == false && is_clock_source == false && is_clock_pin == true"]
set end_TG_CLOCK [filter_collection [all_fanout -from $PIN -flat -endpoints_only] "is_clock_source == true || is_clock_source_network == true "]
                while {[sizeof_collection $end_TG_CLOCK] != "0"} {
                        foreach_in_collection FF $end_TG_CLOCK {
                                if {[sizeof_collection [get_port -q $FF]] == 0} {
                                        if {[get_attribute [filter_collection [get_pin -of [get_cell -q -of $FF]] "direction == out"] is_clock_network] == "true"} {
                                        append_to_collection end_TG_CLOCK [filter_collection [all_fanout -from $FF -flat -endpoints_only] "is_clock_source == true || is_clock_source_network == true ||is_clock_network_cell == true"]
                                        append_to_collection end_TG [filter_collection [all_fanout -from $FF -flat ] "(is_clock_source_network == false && is_clock_source == false && is_clock_pin == true) || (is_clock_source_network == true) || (is_clock_source == true) "]
                                        set end_TG_CLOCK [remove_from_collection $end_TG_CLOCK [get_pin -q $FF]]
                                        }
                                }
                        }
                }
echo "-----------------------------------------------------------------------------------------------"
set end_TG_temp [get_cell -of $end_TG]
set end_TG_end [add_to_collection -u $end_TG_temp $end_TG_temp]

set NUM_PATH_c  0
set WNS_c ""
set TNS_c 0
set NUM_PATH_l  0
set WNS_l ""
set TNS_l 0
        set timing_path_l [get_timing_path -delay_type $type -from [filter_collection [get_pin -of $end_TG_end] "is_clock_pin == true"] -start_end_pair -slack_lesser_than $value_l]
                if {[llength $timing_path_l] == "0"} {
                } else {
                set NUM_PATH_l [expr $NUM_PATH_l + [sizeof_collection $timing_path_l]]
                set WNS_l [append WNS_l  " [format "%.3f" [findmin [get_attribute $timing_path_l slack]]]"]
                set TNS_l [format "%.3f" [expr $TNS_l + [cal_sum [get_attribute $timing_path_l slack]]]]
                }
        set timing_path_c [get_timing_path -delay_type $type -to [filter_collection [get_pin -of $end_TG_end] "is_data_pin == true"] -start_end_pair -slack_lesser_than $value_c]
                if {[llength $timing_path_c] == "0"} {
                } else {
                set NUM_PATH_c [expr $NUM_PATH_c + [sizeof_collection $timing_path_c]]
                set WNS_c [append WNS_c " [format "%.3f" [findmin [get_attribute $timing_path_c slack]]]"]
                set TNS_c [format "%.3f" [expr $TNS_c + [cal_sum [get_attribute $timing_path_c slack]]]]
                }
set WNS_c [findmin $WNS_c]
set WNS_l [findmin $WNS_l]
puts [format "|%5s (%10s) %10s |%10s | %10s | %10s | %10s | %10s|" [get_attribute [get_pin $PIN] full_name] [get_attribute [get_cell -of $PIN] ref_name] $NUM_PATH_l $WNS_l $TNS_l $NUM_PATH_c $WNS_c $TNS_c]
}
