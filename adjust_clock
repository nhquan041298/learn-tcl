proc get_adjust_from_report {START END type value_l value_c} {

set PATH [get_timing_path -delay $type -from $START -to $END -path_type full_clock_expand]
set SLACK [get_attribute $PATH slack]
set LAUN_CLOCK [COL2LIST [get_attribute [get_attribute [get_attribute $PATH launch_clock_paths] points] object]]
set CAP_CLOCK  [COL2LIST [get_attribute [get_attribute [get_attribute $PATH capture_clock_paths] points] object]]
set COMMON_POINT [get_object_name  [get_attribute $PATH crpr_common_point]]

puts "#### SLACK : $SLACK "
puts "##################### CLOCK PATH ANALYSIS IN LAUNCH PATH --> SHORTEN IN SETUP #########################"
set NOT_COMON_LAUNCH [lrange $LAUN_CLOCK [lsearch $LAUN_CLOCK $COMMON_POINT] end-1]
set n [llength $NOT_COMON_LAUNCH ]
puts [format "%50s %40s"  LAUNCH_PATH CAPTURE_PATH]
puts [format "%-30s %10s %10s %10s %20s %10s %10s" PIN NUM_PATH_LAUN WNS_LAUN TNS_LAUN NUM_PATH_CAP WNS_CAP TNS_CAP]
for {set i 1} {$i <  $n} {set i [expr $i + 1]} {
get_info_for_adjust_clock [lindex $NOT_COMON_LAUNCH $i] $type $value_l $value_c
}

puts "################## CLOCK PATH ANALYSIS IN CAPTURE PATH --> LONGER IN SETUP #############################"
set NOT_COMON_CAP [lrange $CAP_CLOCK [lsearch $CAP_CLOCK $COMMON_POINT] end-1]
set m [llength $NOT_COMON_CAP ]
puts [format "%50s %40s"  LAUNCH_PATH CAPTURE_PATH]
puts [format "%-30s %10s %10s %10s %20s %10s %10s" PIN NUM_PATH_LAUN WNS_LAUN TNS_LAUN NUM_PATH_CAP WNS_CAP TNS_CAP]
for {set j 1} {$j <  $m} {set j [expr $j + 1]} {
get_info_for_adjust_clock [lindex $NOT_COMON_CAP $j] $type $value_l $value_c
}
}



